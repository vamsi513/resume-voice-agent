# Copy to .env and fill in. Never commit .env.
# Only OPENAI_API_KEY is required; everything else has a working default.

# --- Required -----------------------------------------------------------------
# Used for both generation and embeddings.
OPENAI_API_KEY=sk-your-key-here

# --- Generation ---------------------------------------------------------------
# gpt-4o-mini is the default: voice is latency-bound, so a small fast model beats a
# stronger slow one. Any OpenAI chat model works.
CHAT_MODEL=gpt-4o-mini
ROUTER_MODEL=gpt-4o-mini
TEMPERATURE=0.2
MAX_ANSWER_TOKENS=160

# --- Retrieval ----------------------------------------------------------------
# text-embedding-3-small, 1536 dimensions. See README "Embedding model".
EMBEDDING_MODEL=text-embedding-3-small
TOP_K=3
HYBRID_RETRIEVAL=true
# Dense vote weight in the rank fusion. 0.8 was swept on eval/retrieval_set.json.
DENSE_WEIGHT=0.8
# Low backstop: never blocks a real question, catches obvious garbage.
MIN_SIMILARITY=0.12
# Strong-evidence threshold that lets retrieval overrule the router.
HIGH_CONFIDENCE_SIMILARITY=0.35

# --- Conversation -------------------------------------------------------------
# Turns of history replayed into the model. Older turns stay in the checkpoint.
MAX_HISTORY_TURNS=8
# Idle seconds before a session's lock and dedupe entries are freed.
SESSION_IDLE_SECONDS=1800
CHECKPOINT_DB=data/checkpoints.sqlite

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Optional shared secret. If set, Vapi must send it as the X-Vapi-Secret header.
# Set this before exposing the server publicly through a tunnel.
SERVER_SECRET=
# Serves /debug/* and the UI's evidence panel. Turn off for anything public.
DEBUG_PANEL=true

# --- Vapi ---------------------------------------------------------------------
# Not read by the server. The browser page takes these from its own form or the URL
# query string; they are listed here so the setup is documented in one place.
# The PUBLIC key is safe in a browser. Never put a private key in client code.
# VAPI_PUBLIC_KEY=
# VAPI_ASSISTANT_ID=
